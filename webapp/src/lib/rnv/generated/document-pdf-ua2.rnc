
namespace NoNS = ""
namespace pdf1 = "http://iso.org/pdf/ssn"
namespace pdf2 = "http://iso.org/pdf2/ssn"
namespace mml = "http://www.w3.org/1998/Math/MathML"

# Attribute namespaces
namespace Layout = "http://iso.org/pdf/ssn/Layout"
namespace PrintField = "http://iso.org/pdf/ssn/PrintField"
namespace Table = "http://iso.org/pdf/ssn/Table"
namespace List = "http://iso.org/pdf/ssn/List"
namespace Artifact = "http://iso.org/pdf/ssn/Artifact"
namespace FENote = "http://iso.org/pdf/ssn/FENote"

# XHTML Namespace (if needed)
namespace h = "http://www.w3.org/1999/xhtml"

# PDF/UA-2 Schema
start = Document | DocumentFragment

# Attribute Definitions

# Layout Attributes

Placement_attribute = attribute Layout:Placement { "Block" | "Inline" | "Before" | "Start" | "End" }?

WritingMode_attribute = attribute Layout:WritingMode { "LrTb" | "RlTb" | "TbRl" | "TbLr" | "LrBt" | "RlBt" | "BtRl" | "BtLr" }?

BackgroundColor_attribute = attribute Layout:BackgroundColor { list { xsd:string* } }?

BorderColor_attribute = attribute Layout:BorderColor { list { xsd:string* } }?

BorderStyle_attribute = attribute Layout:BorderStyle { "None" | "Hidden" | "Dotted" | "Dashed" | "Solid" | "Double" | "Groove" | "Ridge" | "Inset" | "Outset" | list { xsd:string* } }?

BorderThickness_attribute = attribute Layout:BorderThickness { xsd:decimal | list { xsd:string* } }?

Padding_attribute = attribute Layout:Padding { xsd:decimal | list { xsd:string* } }?

Color_attribute = attribute Layout:Color { list { xsd:string* } }?

SpaceBefore_attribute = attribute Layout:SpaceBefore { xsd:decimal }?

SpaceAfter_attribute = attribute Layout:SpaceAfter { xsd:decimal }?

StartIndent_attribute = attribute Layout:StartIndent { xsd:decimal }?

EndIndent_attribute = attribute Layout:EndIndent { xsd:decimal }?

TextIndent_attribute = attribute Layout:TextIndent { xsd:decimal }?

TextAlign_attribute = attribute Layout:TextAlign { "Start" | "Center" | "End" | "Justify" }?

BBox_attribute = attribute Layout:BBox { list { xsd:decimal, xsd:decimal, xsd:decimal, xsd:decimal } }?

Width_attribute = attribute Layout:Width { "Auto" | xsd:decimal }?

Height_attribute = attribute Layout:Height { "Auto" | xsd:decimal }?

BlockAlign_attribute = attribute Layout:BlockAlign { "Before" | "Middle" | "After" | "Justify" }?

InlineAlign_attribute = attribute Layout:InlineAlign { "Start" | "Center" | "End" }?

TBorderStyle_attribute = attribute Layout:TBorderStyle { "None" | "Hidden" | "Dotted" | "Dashed" | "Solid" | "Double" | "Groove" | "Ridge" | "Inset" | "Outset" | list { xsd:string* } }?

TPadding_attribute = attribute Layout:TPadding { xsd:decimal | list { xsd:string* } }?

BaselineShift_attribute = attribute Layout:BaselineShift { xsd:decimal }?

LineHeight_attribute = attribute Layout:LineHeight { "Normal" | "Auto" | xsd:decimal }?

TextPosition_attribute = attribute Layout:TextPosition { "Sup" | "Sub" | "Normal" }?

TextDecorationColor_attribute = attribute Layout:TextDecorationColor { list { xsd:string* } }?

TextDecorationThickness_attribute = attribute Layout:TextDecorationThickness { xsd:decimal }?

TextDecorationType_attribute = attribute Layout:TextDecorationType { "None" | "Underline" | "Overline" | "LineThrough" }?

RubyAlign_attribute = attribute Layout:RubyAlign { "Start" | "Center" | "End" | "Justify" | "Distribute" }?

RubyPosition_attribute = attribute Layout:RubyPosition { "Before" | "After" | "Warichu" | "Inline" }?

GlyphOrientationVertical_attribute = attribute Layout:GlyphOrientationVertical { "Auto" | xsd:decimal }?

ColumnCount_attribute = attribute Layout:ColumnCount { xsd:integer }?

ColumnGap_attribute = attribute Layout:ColumnGap { xsd:decimal | list { xsd:string* } }?

ColumnWidths_attribute = attribute Layout:ColumnWidths { xsd:decimal | list { xsd:string* } }?

Layout_attributes = 
    Placement_attribute,
    WritingMode_attribute,
    BackgroundColor_attribute,
    BorderColor_attribute,
    BorderStyle_attribute,
    BorderThickness_attribute,
    Padding_attribute,
    Color_attribute,
    SpaceBefore_attribute,
    SpaceAfter_attribute,
    StartIndent_attribute,
    EndIndent_attribute,
    TextIndent_attribute,
    TextAlign_attribute,
    BBox_attribute,
    Width_attribute,
    Height_attribute,
    BlockAlign_attribute,
    InlineAlign_attribute,
    TBorderStyle_attribute,
    TPadding_attribute,
    BaselineShift_attribute,
    LineHeight_attribute,
    TextPosition_attribute,
    TextDecorationColor_attribute,
    TextDecorationThickness_attribute,
    TextDecorationType_attribute,
    RubyAlign_attribute,
    RubyPosition_attribute,
    GlyphOrientationVertical_attribute,
    ColumnCount_attribute,
    ColumnGap_attribute,
    ColumnWidths_attribute

# List Attributes

ListNumbering_attribute = attribute List:ListNumbering { "None" | "Unordered" | "Description" | "Disc" | "Circle" | "Square" | "Ordered" | "Decimal" | "UpperRoman" | "LowerRoman" | "UpperAlpha" | "LowerAlpha" }?

ContinuedList_attribute = attribute List:ContinuedList { "true" | "false" }?

ContinuedFrom_attribute = attribute List:ContinuedFrom { xsd:string }?

List_attributes = 
    ListNumbering_attribute,
    ContinuedList_attribute,
    ContinuedFrom_attribute

# PrintField Attributes

Role_attribute = attribute PrintField:Role { "rb" | "cp" | "pb" | "tv" | "lb" }?

Checked__checked_attribute = attribute PrintField:Checked__checked { "on" | "off" }?

Desc_attribute = attribute PrintField:Desc { xsd:string }?

PrintField_attributes = 
    Role_attribute,
    Checked__checked_attribute,
    Desc_attribute

# Table Attributes

RowSpan_attribute = attribute Table:RowSpan { xsd:integer }?

ColSpan_attribute = attribute Table:ColSpan { xsd:integer }?

Headers_attribute = attribute Table:Headers { list { xsd:string* } }?

Scope_attribute = attribute Table:Scope { "Both" | "Column" | "Row" }?

Summary_attribute = attribute Table:Summary { xsd:string }?

Short_attribute = attribute Table:Short { xsd:string }?

Table_attributes = 
    RowSpan_attribute,
    ColSpan_attribute,
    Headers_attribute,
    Scope_attribute,
    Summary_attribute,
    Short_attribute

# Artifact Attributes

Type_attribute = attribute Artifact:Type { "Pagination" | "Layout" | "Page" | "Inline" }?

BBox_attribute = attribute Artifact:BBox { list { xsd:decimal, xsd:decimal, xsd:decimal, xsd:decimal } }?

Subtype_attribute = attribute Artifact:Subtype { "Header" | "Footer" | "Watermark" | "PageNum" | "Bates" | "LineNum" | "Redaction" }?

Artifact_attributes = 
    Type_attribute,
    BBox_attribute,
    Subtype_attribute

# FENote Attributes

NoteType_attribute = attribute FENote:NoteType { "Footnote" | "Endnote" | "None" }?

FENote_attributes = 
    NoteType_attribute

# Structure Element Definitions

# Common attribute patterns
structure_properties = 
    attribute xml:lang { xsd:language }?,
    attribute id { xsd:ID }?,
    Layout_attributes?,
    Table_attributes?,
    List_attributes?,
    PrintField_attributes?,
    Artifact_attributes?,
    FENote_attributes?

pdf2_attributes = structure_properties

# Text content pattern
textorHTML = text

Document = element pdf1:Document {
    pdf2_attributes,
    (Document* | DocumentFragment* | Part* | Art* | Div* | Sect* | TOC* | Aside* | BlockQuote* | NonStruct* | Private* | P* | Note* | Code* | Hn* | H? | Title* | Link* | Annot* | Form* | FENote* | Index* | L* | Table* | Figure* | Formula* | Artifact*)*
}

DocumentFragment = element pdf1:DocumentFragment {
    pdf2_attributes,
    (Document* | DocumentFragment* | Part* | Art* | Div* | Sect* | TOC* | Aside* | BlockQuote* | NonStruct* | Private* | P* | Note* | Code* | Hn* | H? | Title* | Link* | Annot* | Form* | FENote* | Index* | L* | Table* | Figure* | Formula* | Artifact*)*
}

